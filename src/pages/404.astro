---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这里什么都没有">
  <div class="wrap not-found">
    <p class="code">404</p>
    <h1>走错路了</h1>
    <p>这个页面不存在，也许它搬走了，或者从来没来过。</p>
    <a class="button" href={import.meta.env.BASE_URL}>回到首页</a>
  </div>
</BaseLayout>
