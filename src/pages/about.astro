---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const page = await getCollection('pages', ({ id }) => id === 'about').then((items) => items[0]);
if (!page) throw new Error('缺少 src/content/pages/about.md');

const { Content } = await render(page);
---

<BaseLayout title="关于" description={`关于 ${SITE.authorName} 和这个博客`}>
  <div class="wrap">
    <header class="page-head">
      <h1>关于</h1>
      <p>关于我，以及这个小小的博客。</p>
    </header>

    <section class="section">
      <div class="about-card">
        <div class="profile">
          <div class="avatar">
            <img src={`${import.meta.env.BASE_URL}images/mascot.jpg`} alt="吉祥物小狗头像" width="64" height="64" loading="lazy" />
          </div>
          <div>
            <h2>{SITE.authorName}</h2>
            <p>{SITE.shortTitle} · {SITE.role} · 常驻吉祥物：捧咖啡的小狗</p>
          </div>
        </div>
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
