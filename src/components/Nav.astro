---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const normalize = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const current = normalize(path || '/');

function isActive(href: string) {
  const target = normalize(href);
  if (target === '/') return current === '/';
  return current === target || (target === '/archive' && current.startsWith('/posts/'));
}
---

<header class="site-header">
  <div class="wrap-wide nav">
    <a class="brand" href={import.meta.env.BASE_URL} aria-label={SITE.title}>
      <span class="brand-mark" aria-hidden="true">颜</span>
      <span>{SITE.shortTitle}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {NAV.map((item) => (
        <a href={import.meta.env.BASE_URL + item.href.slice(1)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="切换深浅主题" title="切换深浅主题">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  })();
</script>
