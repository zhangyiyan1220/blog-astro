---
import type { Post } from '../lib/posts';
import { formatShortDate, plainText } from '../lib/posts';

interface Props {
  posts: Post[];
  showExcerpt?: boolean;
}

const { posts, showExcerpt = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{posts.length === 0 ? (
  <div class="empty">这里还没有文章。先写一篇，再回来看看。</div>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <time class="post-date" datetime={post.data.date.toISOString()}>
          {formatShortDate(post.data.date)}
        </time>
        <div>
          <h3 class="post-title">
            <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
          </h3>
          {showExcerpt && (
            <p class="post-excerpt">{post.data.description || plainText(post.body)}</p>
          )}
          {post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <a class="tag" href={`${base}tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
              ))}
            </div>
          )}
        </div>
      </li>
    ))}
  </ul>
)}
